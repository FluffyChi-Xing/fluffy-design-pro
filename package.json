{
  "name": "fluffy-design-pro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter @fluffy-design-pro/cli build",
    "check": "pnpm --filter @fluffy-design-pro/cli check",
    "test": "pnpm --filter @fluffy-design-pro/cli test",
    "docs:dev": "pnpm --filter @fluffy-design-pro/docs dev",
    "docs:build": "pnpm --filter @fluffy-design-pro/docs build",
    "docs:preview": "pnpm --filter @fluffy-design-pro/docs preview",
    "playground": "pnpm --dir playground dev",
    "playground:check": "pnpm --dir playground check",
    "playground:build": "pnpm --dir playground build"
  }
}
